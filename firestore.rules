      allow create: if isAdmin() && isValidId(jobId) && isValidTenantDoc(incoming()) && incoming().userId == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time && exists(/databases/$(database)/documents/schools/$(incoming().schoolId));
