      allow update: if isVerifiedUser() && isValidId(experimentId) && isValidTenantDoc(incoming()) && incoming().schoolId == existing().schoolId && incoming().userId == existing().userId && incoming().createdBy == existing().createdBy && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && (
